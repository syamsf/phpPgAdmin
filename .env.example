# Settings for the Docker image (docker run --env-file .env, or env_file in
# Compose). README.md describes each one. Empty means the default.

# --- Sign-in and saved logins -------------------------------------------
# sso (a sign-in proxy sends the user in headers) or local (users kept here). Required.
AUTH_MODE=
# Members of this group are admins. Required.
AUTH_ADMIN_GROUP=
# sso only: address/CIDR of the sign-in proxy, e.g. 10.0.0.5/32. Others get 403.
AUTH_TRUSTED_PROXIES=
# sso only: header with the username.
AUTH_USER_HEADER=Remote-User
# sso only: header with the comma-separated groups.
AUTH_GROUPS_HEADER=Remote-Groups
# sso only: the proxy's logout page for Sign out; empty hides Sign out.
AUTH_SIGNOUT_URL=
# Minutes without a request before the session is cleared; 0 = never.
AUTH_IDLE_MINUTES=30
# File with the encryption key (openssl rand -base64 32 > vault_key). Wins over VAULT_KEY.
VAULT_KEY_FILE=
# The key inline, base64 of 32 bytes, if you can't mount a file.
VAULT_KEY=
# SQLite file with saved logins, on a local volume.
VAULT_DB_PATH=/data/vault.sqlite
# false = only the servers in PPA_SERVERS. Servers added in the UI are off
# (out of the tree, their logins unusable) and can't be added or changed.
SERVERS_ALLOW_UI=true

# --- Servers ------------------------------------------------------------
# Name=host:port, separated by commas; /db1+db2 for a login per database;
# ?pgbouncer=1 for a server behind PgBouncer (gets no statement timeout).
PPA_SERVERS=Main=db.example.internal:5432
# disable, allow, prefer, require, verify-ca or verify-full.
PPA_SSLMODE=prefer
# CA certificate (path inside the container) for verify-ca / verify-full.
PPA_SSLROOTCERT=
# Database to connect to before you pick one.
PPA_DEFAULTDB=postgres
# Seconds to wait for a server to accept a connection.
PGCONNECT_TIMEOUT=10

# --- App ----------------------------------------------------------------
# Block superuser names and empty passwords on the login page.
PPA_EXTRA_LOGIN_SECURITY=true
# Only list databases the user owns.
PPA_OWNED_ONLY=false
# Show aggregates, types, operators, casts and so on.
PPA_SHOW_ADVANCED=false
# Show system objects.
PPA_SHOW_SYSTEM=false
# Show comments.
PPA_SHOW_COMMENTS=true
# PostgreSQL 11 and older only.
PPA_SHOW_OIDS=false
# auto follows the browser; otherwise a file name from lang/, e.g. english.
PPA_DEFAULT_LANG=auto
# default, bootstrap, cappuccino, dark or gotar.
PPA_THEME=default
# Rows per page when browsing.
PPA_MAX_ROWS=30
# Characters shown per field before cutting it off.
PPA_MAX_CHARS=50
# Bigger tables (planner estimate) are browsed without an exact row count.
PPA_BROWSE_EXACT_COUNT_LIMIT=100000
# Rows shown on the SQL results page without pagination.
PPA_MAX_RESULT_ROWS=1000
# Minimum length of a new role password.
PPA_MIN_PASSWORD_LENGTH=1
# Width of the tree on the left, in pixels.
PPA_LEFT_WIDTH=200
# Seconds between refreshes on the locks and processes pages; 0 = off.
PPA_AJAX_REFRESH=3
# default on, default off or disable.
PPA_AUTOCOMPLETE=default on
# Comma-separated plugin names, e.g. Report.
PPA_PLUGINS=
# Cancel statements that run longer than this, e.g. 30s; empty = no limit.
PPA_STATEMENT_TIMEOUT=
# 1 when the site is served over HTTPS.
PHP_SESSION_COOKIE_SECURE=0
